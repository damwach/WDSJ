{
  "name": "skylift-3d",
  "version": "0.10.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "build:pages": "tsc --noEmit && vite build --base=/WDSJ/",
    "build:standalone": "npm run build && node scripts/standalone.mjs",
    "test": "vitest run",
    "test:visual": "playwright test",
    "measure:body": "node scripts/measure-body-area.mjs"
  },
  "dependencies": {
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@types/three": "^0.180.0",
    "typescript": "^5.9.3",
    "vite": "^7.1.9",
    "vitest": "^3.2.4",
    "@playwright/test": "^1.56.0"
  }
}
